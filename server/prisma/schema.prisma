generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================
// TENANCY
// =========================================================

model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique // url-safe identifier used to pick the company at login (multi-tenant demo)
  createdAt DateTime @default(now())

  users              User[]
  customers          Customer[]
  products           Product[]
  warehouses         Warehouse[]
  discountTiers      DiscountTier[]
  categoryLimits     CategoryDiscountLimit[]
  approvalChainRules ApprovalChainRule[]
  scoreReasons       ScoreReason[]
  quotations         Quotation[]
  subscriptionPlans  SubscriptionPlan[]
  upsellRules        UpsellRule[]
  auditLogs          AuditLog[]
}

// =========================================================
// IDENTITY
// =========================================================

enum UserRole {
  SALES_REP
  MANAGER
  FINANCE
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  email        String
  passwordHash String
  name         String
  role         UserRole
  createdAt    DateTime @default(now())

  quotationsAsRep      Quotation[]           @relation("RepQuotations")
  approvalSteps        ApprovalStep[]
  auditLogs            AuditLog[]
  negotiationProposals NegotiationProposal[]
  quotationsAsRep Quotation[]    @relation("RepQuotations")
  approvalSteps   ApprovalStep[]
  auditLogs       AuditLog[]

  @@unique([companyId, email])
  @@index([companyId])
}

enum CustomerTier {
  BRONZE
  SILVER
  GOLD
}

model Customer {
  id                 String       @id @default(cuid())
  companyId          String
  company            Company      @relation(fields: [companyId], references: [id])
  name               String
  email              String
  tier               CustomerTier @default(BRONZE)
  portalPasswordHash String?

  // --- Reliability score ---
  reliabilityScore       Int @default(100) // clamp 0-100 in application logic; starts at 100
  consecutiveOnTimeCount Int @default(0) // resets to 0 on any late event

  createdAt DateTime @default(now())

  quotations           Quotation[]
  scoreEvents          ScoreEvent[]
  payments             Payment[]
  negotiationProposals NegotiationProposal[]
  quotations  Quotation[]
  scoreEvents ScoreEvent[]
  payments    Payment[]

  @@unique([companyId, email])
  @@index([companyId])
}

// =========================================================
// CUSTOMER SCORE ENGINE
// =========================================================

// Company-configurable reasons — NOT an enum, so new reasons can be added
// (e.g. "RETURNED_GOODS", "REFERRAL_BONUS") without a schema migration.
model ScoreReason {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  code         String // e.g. "VERY_LATE_PAYMENT" - used by app logic to look this up
  label        String // human-readable, e.g. "Payment more than 10 days late"
  defaultDelta Int // fixed penalty/bonus, e.g. -20, -10, +3, +5
  isPenalty    Boolean // convenience flag for filtering/reporting
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  scoreEvents ScoreEvent[]

  @@unique([companyId, code])
}

// Immutable audit trail of every score change. Customer.reliabilityScore
// is a cached/denormalized value; this table is the source of truth.
model ScoreEvent {
  id                    String        @id @default(cuid())
  customerId            String
  customer              Customer      @relation(fields: [customerId], references: [id])
  companyId             String
  scoreReasonId         String
  scoreReason           ScoreReason   @relation(fields: [scoreReasonId], references: [id])
  delta                 Int // copied from ScoreReason.defaultDelta at time of event (snapshot)
  scoreBefore           Int // clamped 0-100
  scoreAfter            Int // clamped 0-100
  note                  String?
  // Who or what caused this score change: userId if human-triggered, or
  // "SYSTEM:<job_name>" for automated triggers (e.g. "SYSTEM:PAYMENT_CRON")
  triggeredBy           String
  relatedBillingEventId String?
  relatedBillingEvent   BillingEvent? @relation(fields: [relatedBillingEventId], references: [id])
  relatedQuotationId    String?
  relatedQuotation      Quotation?    @relation(fields: [relatedQuotationId], references: [id])
  createdAt             DateTime      @default(now())

  @@index([customerId])
  @@index([companyId])
}

// =========================================================
// CATALOG
// =========================================================

model Product {
  id            String  @id @default(cuid())
  companyId     String
  company       Company @relation(fields: [companyId], references: [id])
  name          String
  category      String
  basePrice     Decimal @db.Decimal(12, 2)
  unit          String
  taxRate       Decimal @db.Decimal(5, 2)
  description   String?
  marginPercent Decimal @db.Decimal(5, 2)

  variants          ProductVariant[]
  priceListEntries  PriceListEntry[]
  quotationLines    QuotationLine[]
  stockLevels       StockLevel[]
  subscriptionPlans SubscriptionPlan[]
  upsellAsBase      UpsellRule[]       @relation("BaseProduct")
  upsellAsSuggested UpsellRule[]       @relation("SuggestedProduct")

  @@index([companyId, category])
}

model ProductVariant {
  id             String  @id @default(cuid())
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  attributeName  String // e.g. "Size"
  attributeValue String // e.g. "Large"
  extraPrice     Decimal @db.Decimal(12, 2)

  quotationLines QuotationLine[]
}

model PriceListEntry {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id])
  tier      CustomerTier
  currency  String
  price     Decimal      @db.Decimal(12, 2)

  @@unique([productId, tier, currency])
}

// =========================================================
// DISCOUNT GOVERNANCE
// =========================================================

model DiscountTier {
  id                 String       @id @default(cuid())
  companyId          String
  company            Company      @relation(fields: [companyId], references: [id])
  tier               CustomerTier
  maxDiscountPercent Decimal      @db.Decimal(5, 2)

  @@unique([companyId, tier])
}

model CategoryDiscountLimit {
  id                 String  @id @default(cuid())
  companyId          String
  company            Company @relation(fields: [companyId], references: [id])
  category           String
  maxDiscountPercent Decimal @db.Decimal(5, 2)

  @@unique([companyId, category])
}

model ApprovalChainRule {
  id                 String  @id @default(cuid())
  companyId          String
  company            Company @relation(fields: [companyId], references: [id])
  minDiscountPercent Decimal @db.Decimal(5, 2)
  maxDiscountPercent Decimal @db.Decimal(5, 2)
  requiresManager    Boolean @default(true)
  requiresFinance    Boolean @default(false)
  // Controls which rule fires first when multiple rules match a quotation.
  // Lower number = evaluated/applied first.
  priority           Int     @default(0)
}

// =========================================================
// QUOTATION / ORDER
// =========================================================

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  NEGOTIATING
  CONFIRMED
  FULFILLED
  CANCELLED
}

model Quotation {
  id                   String          @id @default(cuid())
  companyId            String
  company              Company         @relation(fields: [companyId], references: [id])
  customerId           String
  customer             Customer        @relation(fields: [customerId], references: [id])
  repId                String
  rep                  User            @relation("RepQuotations", fields: [repId], references: [id])
  status               QuotationStatus @default(DRAFT)
  blendedRiskScore     Decimal?        @db.Decimal(6, 2)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  lastActivityAt       DateTime        @default(now()) // updated on every meaningful action; used for stalled-deal detection
  expiresAt            DateTime? // quotation expiry — lapsing triggers late-cancellation score check
  cancelledAt          DateTime?
  confirmationDeadline DateTime? // deadline for customer to confirm terms
  promisedDeliveryDate DateTime? // promised delivery date; compared against actual fulfillment for Deal Health slippage

  lines                QuotationLine[]
  approvalSteps        ApprovalStep[]
  negotiationRequests  NegotiationRequest[]
  negotiationProposals NegotiationProposal[]
  scoreEvents          ScoreEvent[]

  @@index([companyId, status])
  @@index([companyId, repId])
}

enum LineType {
  ONE_TIME
  RECURRING
}

model QuotationLine {
  id                   String          @id @default(cuid())
  quotationId          String
  quotation            Quotation       @relation(fields: [quotationId], references: [id])
  productId            String
  product              Product         @relation(fields: [productId], references: [id])
  variantId            String?
  variant              ProductVariant? @relation(fields: [variantId], references: [id])
  quantity             Int
  unitPrice            Decimal         @db.Decimal(12, 2)
  discountPercent      Decimal         @db.Decimal(5, 2)
  categoryLimitAtTime  Decimal         @db.Decimal(5, 2) // snapshot of CategoryDiscountLimit at time of line creation (audit)
  tierLimitAtTime      Decimal         @db.Decimal(5, 2) // snapshot of DiscountTier limit at time of line creation (audit)
  lineType             LineType        @default(ONE_TIME)

  fulfillmentSplits    FulfillmentSplit[]
  subscription         Subscription?
  stockReservations    StockReservation[]
  negotiationRequests  NegotiationRequest[]
  negotiationProposals NegotiationProposal[]
  id                  String          @id @default(cuid())
  quotationId         String
  quotation           Quotation       @relation(fields: [quotationId], references: [id])
  productId           String
  product             Product         @relation(fields: [productId], references: [id])
  variantId           String?
  variant             ProductVariant? @relation(fields: [variantId], references: [id])
  quantity            Int
  unitPrice           Decimal         @db.Decimal(12, 2)
  discountPercent     Decimal         @db.Decimal(5, 2)
  categoryLimitAtTime Decimal         @db.Decimal(5, 2) // snapshot of CategoryDiscountLimit at time of line creation (audit)
  tierLimitAtTime     Decimal         @db.Decimal(5, 2) // snapshot of DiscountTier limit at time of line creation (audit)
  lineType            LineType        @default(ONE_TIME)

  fulfillmentSplits   FulfillmentSplit[]
  subscription        Subscription?
  stockReservations   StockReservation[]
  negotiationRequests NegotiationRequest[]
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
}

model ApprovalStep {
  id           String         @id @default(cuid())
  quotationId  String
  quotation    Quotation      @relation(fields: [quotationId], references: [id])
  approverRole UserRole
  approverId   String?
  approver     User?          @relation(fields: [approverId], references: [id])
  status       ApprovalStatus @default(PENDING)
  reason       String?
  actedAt      DateTime?
  createdAt    DateTime       @default(now())
  // Defines the order of this step in the approval chain (1 = first, 2 = second, etc.)
  // Ensures Manager approval always happens before Finance approval.
  stepOrder    Int            @default(1)
}

// =========================================================
// GENERIC AUDIT LOG
// Covers: Quotation created, ApprovalStep approved/rejected,
// Subscription cancelled, etc. — one table for all entity actions.
// =========================================================

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  userId     String? // null for system-generated actions
  user       User?    @relation(fields: [userId], references: [id])
  entityType String // "Quotation" | "ApprovalStep" | "Subscription" | ...
  entityId   String
  action     String // "CREATED" | "APPROVED" | "REJECTED" | "CANCELLED" | ...
  metadata   Json? // e.g. { "oldDiscount": 10, "newDiscount": 18 }
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([companyId])
}

// =========================================================
// UPSELL
// =========================================================

model UpsellRule {
  id                 String  @id @default(cuid())
  companyId          String
  company            Company @relation(fields: [companyId], references: [id])
  baseProductId      String
  baseProduct        Product @relation("BaseProduct", fields: [baseProductId], references: [id])
  suggestedProductId String
  suggestedProduct   Product @relation("SuggestedProduct", fields: [suggestedProductId], references: [id])
  isPromoted         Boolean @default(false)
  minMarginPercent   Decimal @db.Decimal(5, 2)

  @@unique([companyId, baseProductId, suggestedProductId])
}

// =========================================================
// FULFILLMENT
// =========================================================

model Warehouse {
  id                 String  @id @default(cuid())
  companyId          String
  company            Company @relation(fields: [companyId], references: [id])
  name               String
  shippingCostWeight Decimal @db.Decimal(6, 2)

  stockLevels       StockLevel[]
  fulfillmentSplits FulfillmentSplit[]
  stockReservations StockReservation[]
}

model StockLevel {
  id                     String    @id @default(cuid())
  warehouseId            String
  warehouse              Warehouse @relation(fields: [warehouseId], references: [id])
  productId              String
  product                Product   @relation(fields: [productId], references: [id])
  companyId              String // denormalized for efficient company-scoped stock queries
  quantityAvailable      Int // total physical stock
  quantityReserved       Int       @default(0) // held against open quotations
  replenishmentThreshold Int
  // Sellable stock = quantityAvailable - quantityReserved (compute in app logic)

  reservations      StockReservation[]
  fulfillmentSplits FulfillmentSplit[]

  @@unique([warehouseId, productId])
  @@index([companyId])
}

enum ReservationStatus {
  HELD // quotation is open/pending, stock is locked
  RELEASED // quotation was rejected/expired/cancelled, stock given back
  CONSUMED // order confirmed & fulfilled, stock permanently deducted
}

// Created the moment a quotation line is added with a warehouse split.
// Keeps "why is this stock unavailable" traceable and reversible.
model StockReservation {
  id               String            @id @default(cuid())
  quotationLineId  String
  quotationLine    QuotationLine     @relation(fields: [quotationLineId], references: [id])
  warehouseId      String
  warehouse        Warehouse         @relation(fields: [warehouseId], references: [id])
  // Direct FK to StockLevel so the expiry job can efficiently decrement quantityReserved
  // without re-joining on warehouseId + productId every time.
  stockLevelId     String
  stockLevel       StockLevel        @relation(fields: [stockLevelId], references: [id])
  quantityReserved Int
  status           ReservationStatus @default(HELD)
  expiresAt        DateTime? // 48h TTL — cron auto-releases HELD reservations past this
  releasedAt       DateTime?
  createdAt        DateTime          @default(now())

  @@index([status, expiresAt]) // cron job query: WHERE status = 'HELD' AND expiresAt < now()
}

model FulfillmentSplit {
  id                String        @id @default(cuid())
  quotationLineId   String
  quotationLine     QuotationLine @relation(fields: [quotationLineId], references: [id])
  warehouseId       String
  warehouse         Warehouse     @relation(fields: [warehouseId], references: [id])
  // Direct FK to StockLevel so consumption can update quantityAvailable efficiently.
  stockLevelId      String
  stockLevel        StockLevel    @relation(fields: [stockLevelId], references: [id])
  quantityFulfilled Int
  isBackorder       Boolean       @default(false)
  fulfilledAt       DateTime? // set when actually dispatched; null = pending/backorder
}

// =========================================================
// SUBSCRIPTION / BILLING
// =========================================================

enum BillingCycle {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ProrationRule {
  DAILY_RATE
  NO_PRORATION
  FULL_PERIOD
}

enum CancellationRefundRule {
  NO_REFUND
  PRORATED
  FULL_PERIOD_REFUND
}

model SubscriptionPlan {
  id                     String                 @id @default(cuid())
  companyId              String
  company                Company                @relation(fields: [companyId], references: [id])
  productId              String
  product                Product                @relation(fields: [productId], references: [id])
  name                   String // e.g. "Standard Monthly", "Annual Pro" — needed to distinguish plans for the same product
  billingCycle           BillingCycle
  prorationRule          ProrationRule
  cancellationRefundRule CancellationRefundRule

  subscriptions Subscription[]
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

model Subscription {
  id               String             @id @default(cuid())
  quotationLineId  String             @unique
  quotationLine    QuotationLine      @relation(fields: [quotationLineId], references: [id])
  planId           String
  plan             SubscriptionPlan   @relation(fields: [planId], references: [id])
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime
  nextBillingDate  DateTime
  cancelledAt      DateTime?

  billingEvents BillingEvent[]
}

enum BillingEventType {
  INVOICE
  REFUND
  CREDIT_NOTE
  PRORATION
}

model BillingEvent {
  id             String           @id @default(cuid())
  subscriptionId String
  subscription   Subscription     @relation(fields: [subscriptionId], references: [id])
  type           BillingEventType
  amount         Decimal          @db.Decimal(12, 2)
  dueDate        DateTime
  paidAt         DateTime? // null + past dueDate = overdue; Payment is the actual record

  scoreEvents ScoreEvent[]
  payments    Payment[]

  @@index([subscriptionId])
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  UPI
  CHEQUE
  OTHER
}

// The actual payment transaction record.
// A scheduled job (or webhook) reads this table to decide which ScoreEvent to fire.
model Payment {
  id             String        @id @default(cuid())
  billingEventId String
  billingEvent   BillingEvent  @relation(fields: [billingEventId], references: [id])
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  paidAt         DateTime
  daysLate       Int           @default(0) // negative = early, 0 = on time, positive = days late
  createdAt      DateTime      @default(now())

  @@index([customerId])
}

// =========================================================
// CUSTOMER PORTAL NEGOTIATION
// =========================================================

enum NegotiationType {
  COMMENT
  COUNTER_DISCOUNT
  CONFIRM
}

enum NegotiationStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model NegotiationRequest {
  id                    String            @id @default(cuid())
  quotationId           String
  quotation             Quotation         @relation(fields: [quotationId], references: [id])
  // Proper FK to QuotationLine — enables include: { line: true } in Prisma queries
  lineId                String?
  line                  QuotationLine?    @relation(fields: [lineId], references: [id])
  type                  NegotiationType
  message               String?
  proposedDiscount      Decimal?          @db.Decimal(5, 2)
  requestedDeliveryDate DateTime? // customer-requested delivery date (Portal Negotiation screen)
  status                NegotiationStatus @default(OPEN)
  createdAt             DateTime          @default(now())

  @@index([quotationId])
}

// =========================================================
// STRUCTURED NEGOTIATION PROPOSALS
// Overwrite-in-place model: one row per quotation+term.
// Each counter overwrites the same row; the permanent record
// lives in AuditLog, not in a chain of proposal rows.
// =========================================================

enum ProposedByType {
  REP
  CUSTOMER
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model NegotiationProposal {
  id                  String         @id @default(cuid())
  quotationId         String
  quotation           Quotation      @relation(fields: [quotationId], references: [id])

  // null = order-level proposal (e.g. change total order discount)
  // non-null = line-level proposal (e.g. change qty or discount on one line)
  lineId              String?
  line                QuotationLine? @relation(fields: [lineId], references: [id])

  // Who is currently making this proposal (switches on each counter)
  proposedByType      ProposedByType
  proposedByUserId    String?        // set when proposedByType = REP
  proposedByUser      User?          @relation(fields: [proposedByUserId], references: [id])
  proposedByCustomerId String?       // set when proposedByType = CUSTOMER
  proposedByCustomer  Customer?      @relation(fields: [proposedByCustomerId], references: [id])

  // e.g. { "discountPercent": 12, "quantity": 50 }
  // All fields in here are accepted/rejected as one atomic unit — no partial acceptance.
  proposedChanges     Json

  // Snapshot of CategoryDiscountLimit + DiscountTier values at time of proposal creation/counter.
  // Protects against company-wide rule changes happening mid-negotiation.
  snapshotLimits      Json

  status              ProposalStatus @default(PENDING)

  // Still open — recommend 48h TTL for consistency with stock reservation TTL.
  // Set expiresAt when proposal is created/countered; a cron auto-rejects expired PENDING proposals.
  expiresAt           DateTime?

  respondedAt         DateTime?      // set when status moves to ACCEPTED or REJECTED
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([quotationId, status])
}
